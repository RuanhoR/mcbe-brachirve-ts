{
  "name": "mcbe-brarchive-ts",
  "version": "0.1.2",
  "description": "Read/generate Minecraft: Bedrock Edition .brarchive files. A TypeScript port of xKingDark-brachive.",
  "keywords": [
    "minecraft",
    "bedrock",
    "brarchive",
    "archive"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./package.json": {
      "require": "./package.json"
    }
  },
  "bin": {
    "brarchive": "./bin/brarchive.cjs"
  },
  "files": [
    "dist",
    "bin"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "rolldown -c",
    "prepublishOnly": "pnpm build",
    "dev": "pnpm build && node bin/brarchive.js",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:e2e": "vitest run --project e2e",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "rolldown": "^1.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "cac": "^7.0.0",
    "rolldown-plugin-dts": "^0.28.0"
  },
  "packageManager": "pnpm@11.0.0",
  "publishConfig": {
    "access": "public"
  }
}
