{
  "name": "brarchive",
  "version": "1.0.0",
  "description": "Read/generate Minecraft: Bedrock Edition .brarchive files. A TypeScript port of xKingDark-brachive.",
  "keywords": [
    "minecraft",
    "bedrock",
    "brarchive",
    "archive"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "bin": {
    "brarchive": "./bin/brarchive.js"
  },
  "files": [
    "dist",
    "bin"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "rolldown -c",
    "build:dts": "tsc -p tsconfig.build.json",
    "prepublishOnly": "pnpm build && pnpm build:dts",
    "dev": "pnpm build && node bin/brarchive.js",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:e2e": "vitest run --project e2e",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "rolldown": "^1.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "cac": "^7.0.0"
  }
}
